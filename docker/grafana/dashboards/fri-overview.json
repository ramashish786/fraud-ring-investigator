    },
    {
      "type": "stat",
      "title": "API availability (1h)",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "fri-prometheus"
      },
      "description": "Target 99.5%; health checks excluded.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - fri:sli_api_errors:ratio_rate1h",
          "datasource": {
            "type": "prometheus",
            "uid": "fri-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.99
              },
              {
                "color": "green",
                "value": 0.995
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
