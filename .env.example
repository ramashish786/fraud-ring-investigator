# Copy to .env to override the development defaults baked into docker-compose.yml.
# Never commit .env.

ENV=dev
LOG_LEVEL=INFO

# PostgreSQL (compose builds DATABASE_URL from these)
POSTGRES_USER=fri
POSTGRES_PASSWORD=root
POSTGRES_DB=fri

# Neo4j (min 8 chars)
NEO4J_PASSWORD=root

# Auth: use 32+ random characters outside dev, e.g. `python -c "import secrets;print(secrets.token_urlsafe(48))"`
JWT_SECRET=

# LLM (D-010): "fake" runs everything without an API key; "openai" needs all three below
LLM_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_CHAT_MODEL=gpt-5.4
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Observability (docs/SLO.md). Set the OTLP endpoint to export traces to Jaeger when the observability profile runs.
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
WORKER_METRICS_PORT=9101
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=root
